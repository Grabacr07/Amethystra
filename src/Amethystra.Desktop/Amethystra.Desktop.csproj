<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <RootNamespace>Amethystra</RootNamespace>
    <Product>Amethystra</Product>
    <Authors>@Grabacr07</Authors>
    <Company>grabacr.net</Company>
    <Copyright>Copyright © 2023 Manato Kameya</Copyright>
    <Description>@Grabacr07's personal utility suite.</Description>
    <RepositoryUrl>https://github.com/Grabacr07/Amethystra</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Grabacr07/Amethystra</PackageProjectUrl>
    <PackageLicenseFile>..\..\LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>..\..\README.md</PackageReadmeFile>
    <GeneratedThemeResourceKeysFile>$(BaseIntermediateOutputPath)Generated\ThemeResourceKeys.g.cs</GeneratedThemeResourceKeysFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.142" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="R3" Version="1.3.1" />
    <PackageReference Include="R3Extensions.WPF" Version="1.3.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Amethystra.CodeAnalysis\Amethystra.CodeAnalysis.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Amethystra\Amethystra.csproj" />
    <!--
      The generator is referenced as a project so that it takes part in the restore graph
      and the build order, and so that its output path is taken from the build itself.
      This keeps the generation working under any output layout (e.g. dotnet build with artifacts-path).
    -->
    <ProjectReference Include="..\..\tools\ThemeResourceKeyGen\ThemeResourceKeyGen.csproj" OutputItemType="ThemeResourceKeyGenerator" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="GenerateThemeResourceKeys" BeforeTargets="CoreCompile" Condition="'$(TargetFramework)' != ''" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <_WpfUiPackageReference Include="@(PackageReference)" Condition="'%(Identity)' == 'WPF-UI'" />
    </ItemGroup>

    <PropertyGroup>
      <_WpfUiAssemblyPath>$(NuGetPackageRoot)wpf-ui\%(_WpfUiPackageReference.Version)\lib\net10.0-windows7.0\Wpf.Ui.dll</_WpfUiAssemblyPath>
      <_ThemeResourceKeyGeneratorExecutable>@(ThemeResourceKeyGenerator->'%(RootDir)%(Directory)%(Filename).exe')</_ThemeResourceKeyGeneratorExecutable>
    </PropertyGroup>

    <Error Condition="'%(_WpfUiPackageReference.Version)' == ''" Text="Wpf.Ui package reference was not found." />
    <Error Condition="Exists('$(_WpfUiAssemblyPath)') == false" Text="Wpf.Ui assembly was not found at $(_WpfUiAssemblyPath)." />
    <!-- Design-time builds do not build project references, so the generator may not exist yet. -->
    <Error Condition="'$(DesignTimeBuild)' != 'true' And Exists('$(_ThemeResourceKeyGeneratorExecutable)') == false" Text="Theme resource key generator was not found at $(_ThemeResourceKeyGeneratorExecutable)." />

    <Exec Condition="Exists('$(_ThemeResourceKeyGeneratorExecutable)')" Command="&quot;$(_ThemeResourceKeyGeneratorExecutable)&quot; --assembly-path &quot;$(_WpfUiAssemblyPath)&quot; --output-path &quot;$(GeneratedThemeResourceKeysFile)&quot; --namespace &quot;Amethystra.UI.Markup&quot;" />

    <ItemGroup>
      <Compile Include="$(GeneratedThemeResourceKeysFile)" Condition="Exists('$(GeneratedThemeResourceKeysFile)')" Visible="false" />
    </ItemGroup>
  </Target>

</Project>
